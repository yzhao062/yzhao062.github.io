# macOS metadata
.DS_Store

# JetBrains / IntelliJ / PyCharm
.idea/
*.iml

# Keep if you later want to share specific project settings:
# !.idea/codeStyles/
# !.idea/inspectionProfiles/
.agent-config/
/.claude/

# Secrets
.env
.env.local

# Python
__pycache__/
*.pyc

# Local API caches (derived; regenerated on demand)
.cache/

# LaTeX build output
out/

# LaTeX intermediate files (cv/)
cv/*.aux
cv/*.fdb_latexmk
cv/*.fls
cv/*.log
cv/*.out
cv/*.synctex.gz
cv/*.toc
cv/*.lof
cv/*.lot
cv/*.nav
cv/*.snm
cv/*.vrb
cv/*.pdf
agent-config.local.yaml

# Local inbox for documents being processed (offer letters, scans). Never commit: this repo is public.
# Drop box for files handed to agents; keep the folder and its README
# (must be todo/*, not todo/ -- git cannot re-include a file under an excluded directory)
todo/*
!todo/README.md
/AGENTS.md
/CLAUDE.md
/agents/codex.md
